# Sherlock — formato de variables de entorno.
# Copiar a .env y rellenar. El .env real NUNCA va al repo (cada servidor el suyo).

# Puerto libre del servidor (dev y prod usan puertos distintos).
PORT=3021

# 1 cuando la app va por HTTPS detrás de Nginx (dev y prod). 0 solo en local por http.
COOKIE_SECURE=1

# Secreto de sesión: largo y aleatorio. Generar con: openssl rand -base64 48
SESSION_SECRET=cambia-esto-por-algo-aleatorio-y-largo

# Cadena de conexión de Neon Postgres (cada entorno su propia base).
DATABASE_URL=postgres://usuario:password@host.neon.tech/sherlock?sslmode=require

# Un usuario de login por médico. El campo "u" DEBE existir como username en
# sherlock.medicos (lo crea seed.js), o ensureMedicoId responderá 403.
# "role" solo puede ser "soto" o "escobar": el front mapea cédulas y vistas por él.
# Generar las contraseñas en el servidor (openssl rand -base64 9), entregarlas UNA
# vez a cada médico y no pegarlas en chats ni en el repo.
USERS=[{"u":"ssoto","p":"cambiame","role":"soto","name":"Dr. Santos Soto","spec":"Cirugía oncológica de mama"},{"u":"eescobar","p":"cambiame","role":"escobar","name":"Dra. Elizabeth Escobar","spec":"Oncología médica"}]
