# Sherlock — formato de variables de entorno.
# Copiar a .env y rellenar. El .env NUNCA va al repo (está en .gitignore);
# cada servidor (local / dev / prod) tiene el suyo, con sus propias contraseñas.

# Puerto libre en el servidor (Nginx hace proxy hacia aquí).
PORT=3021

# 1 cuando el sitio va por HTTPS detrás de Nginx (dev y prod). 0 en local por http.
COOKIE_SECURE=1

# Secreto de firma de la cookie de sesión. Generar largo y aleatorio:
#   openssl rand -base64 48
SESSION_SECRET=

# Cadena de conexión a Neon Postgres. Usar el endpoint POOLER (-pooler en el host)
# y sslmode=require. El esquema vive en el schema dedicado "sherlock".
#   postgresql://USUARIO:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# URL pública del sitio, sin barra final. La usan los enlaces del feed ICS, que
# descarga el calendario del médico (Google/iPhone/Outlook) y no su navegador:
# por eso no puede deducirse de la cabecera Host. Si se deja vacía se infiere de
# la petición, lo cual sirve en local pero NO en dev ni en prod.
#   dev:  https://sherlock.dev.simplexitypro.com
#   prod: https://sherlock.simplexitypro.com
PUBLIC_URL=

# Usuarios de login (JSON en una sola línea), uno por médico.
#   u    -> username; DEBE coincidir con sherlock.medicos.username (ver seed.js),
#           porque la API resuelve el medico_id por este campo. Si no coincide,
#           toda la API responde 403 "no tiene un médico asociado".
#   p    -> HASH de la contraseña (scrypt), NO la contraseña. Generarlo en el servidor:
#             node hash-password.js              -> contraseña aleatoria + su hash
#             node hash-password.js "mi-clave"   -> hash de esa contraseña
#           La contraseña se imprime UNA vez para entregarla al médico; no se guarda
#           en ningún lado ni se pega en chats o en el repo.
#           Si el valor no empieza con "scrypt$" se trata como texto plano heredado:
#           funciona, pero el servidor avisa al arrancar. Migrarlo cuanto antes.
#   role -> 'soto' o 'escobar' (el front mapea cédulas y vistas por este rol).
USERS=[{"u":"ssoto","p":"scrypt$16384$8$1$<sal>$<hash>","role":"soto","name":"Dr. Santos Soto","spec":"Cirugía oncológica de mama"},{"u":"eescobar","p":"scrypt$16384$8$1$<sal>$<hash>","role":"escobar","name":"Dra. Elizabeth Escobar","spec":"Oncología médica"}]
